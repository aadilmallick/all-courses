<div id="vocabulary-app" class="studio">
  <div class="control-grid"><label>Find a word or theme<input id="vocab-search" type="search" placeholder="French, English, or a topic…" /></label><label>Stage<select id="vocab-chapter"><option value="all">All stages</option>{Array.from({length:10},(_,i)=><option value={i+1}>Stage {i+1}</option>)}</select></label></div>
  <p id="vocab-status" role="status">Loading your vocabulary…</p><div id="vocab-list" class="vocab-grid"></div><button id="vocab-more" hidden>Show more words</button>
</div>
<script>
import {speakFrench} from '../scripts/speech';
const search=document.getElementById('vocab-search') as HTMLInputElement,stage=document.getElementById('vocab-chapter') as HTMLSelectElement,list=document.getElementById('vocab-list')!,status=document.getElementById('vocab-status')!,more=document.getElementById('vocab-more')!;
let words:any[]=[],limit=40;
function draw(){const term=search.value.normalize('NFD').replace(/\p{M}/gu,'').toLowerCase();const filtered=words.filter(v=>(stage.value==='all'||v.chapter===Number(stage.value))&&[v.fr,v.en,v.tag].join(' ').normalize('NFD').replace(/\p{M}/gu,'').toLowerCase().includes(term));list.replaceChildren();status.textContent=`${filtered.length} entries · showing ${Math.min(limit,filtered.length)}. Learn words as phrases, with their grammar.`;for(const v of filtered.slice(0,limit)){const card=document.createElement('article');card.className='vocab-card';const h=document.createElement('h3');h.lang='fr';h.textContent=v.fr;const en=document.createElement('p');en.textContent=v.en;const ex=document.createElement('p');ex.lang='fr';ex.textContent=v.example;const tr=document.createElement('small');tr.textContent=v.translation;const b=document.createElement('button');b.textContent='▶ Hear';b.onclick=()=>speakFrench(v.fr,0.9,undefined,m=>status.textContent=m);const meta=document.createElement('small');meta.textContent=`Stage ${v.chapter} · ${v.tag}`;card.append(meta,h,en,ex,tr,b);list.append(card);}more.hidden=filtered.length<=limit;}
search.oninput=stage.onchange=()=>{limit=40;draw();};more.onclick=()=>{limit+=40;draw();};fetch('/data/course.json').then(r=>r.json()).then(d=>{words=d.chapters.flatMap((c:any)=>c.vocab.map((v:any)=>({...v,chapter:c.chapter})));draw();}).catch(()=>status.textContent='Could not load vocabulary. Reload while the site is available.');
</script>
