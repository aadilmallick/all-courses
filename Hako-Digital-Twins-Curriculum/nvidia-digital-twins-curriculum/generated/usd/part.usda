#usda 1.0
(
    defaultPrim = "Part"
    metersPerUnit = 1
    upAxis = "Z"
)

def Xform "Part" (
    variants = {
        string appearance = "gray"
    }
    prepend variantSets = "appearance"
)
{
    def Cube "Shape" (
        prepend apiSchemas = ["PhysicsCollisionAPI", "PhysicsRigidBodyAPI", "PhysicsMassAPI"]
    )
    {
        float physics:mass = 1
        double size = 0.2
    }
    variantSet "appearance" = {
        "gray" {
            over "Shape"
            {
                color3f[] primvars:displayColor = [(0.5, 0.5, 0.5)]
            }

        }
        "red" {
            over "Shape"
            {
                color3f[] primvars:displayColor = [(0.8, 0.1, 0.1)]
            }

        }
    }
}

