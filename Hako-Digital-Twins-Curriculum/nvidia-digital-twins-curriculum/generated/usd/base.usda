#usda 1.0
(
    defaultPrim = "World"
    metersPerUnit = 1
    upAxis = "Z"
)

def Xform "World"
{
    def Xform "PartA" (
        prepend references = @part.usda@
        variants = {
            string appearance = "red"
        }
    )
    {
        custom double telemetry:position_m = 0.5
        double3 xformOp:translate = (0.5, 0, 0.1)
        uniform token[] xformOpOrder = ["xformOp:translate"]
    }
}

